#!/usr/bin/env bash
set -Eeuo pipefail

# Push every newly created commit to its matching branch on each configured
# remote. Set CAPI_SKIP_AUTO_PUSH=1 for maintenance operations that must not
# push, or override the remote list with CAPI_PUSH_REMOTES.
[[ "${CAPI_SKIP_AUTO_PUSH:-0}" == "1" ]] && exit 0

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
[[ -n "$branch" ]] || exit 0

remotes=(${CAPI_PUSH_REMOTES:-origin prod})
token_file=${CAPI_GITHUB_TOKEN_FILE:-"$HOME/code/ssh/keys/github_token"}

for remote in "${remotes[@]}"; do
  printf '[capi] auto-pushing %s to %s\n' "$branch" "$remote"

  if [[ "$remote" == "origin" ]]; then
    if [[ ! -r "$token_file" ]]; then
      printf '[capi] auto-push failed: GitHub token not readable: %s\n' "$token_file" >&2
      exit 1
    fi

    askpass=$(mktemp)
    cleanup() { rm -f "$askpass"; }
    trap cleanup EXIT
    cat > "$askpass" <<'ASKPASS'
#!/bin/sh
case "$1" in
  *Username*) printf '%s\n' 'x-access-token' ;;
  *Password*) cat "$CAPI_GITHUB_TOKEN_FILE" ;;
  *) printf '\n' ;;
esac
ASKPASS
    chmod 700 "$askpass"

    CAPI_GITHUB_TOKEN_FILE="$token_file" \
    GIT_ASKPASS="$askpass" \
    GIT_TERMINAL_PROMPT=0 \
    git fetch "$remote" "$branch"
    remote_ref="refs/remotes/$remote/$branch"
    if git show-ref --verify --quiet "$remote_ref"; then
      printf '[capi] rebasing %s onto %s/%s\n' "$branch" "$remote" "$branch"
      CAPI_SKIP_AUTO_PUSH=1 git -c rebase.autoStash=true rebase "$remote/$branch"
    fi
    CAPI_GITHUB_TOKEN_FILE="$token_file" \
    GIT_ASKPASS="$askpass" \
    GIT_TERMINAL_PROMPT=0 \
    git push "$remote" "HEAD:$branch"
  else
    GIT_TERMINAL_PROMPT=0 git push "$remote" "HEAD:$branch"
  fi
done
