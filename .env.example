# Storage connection. Leave DATABASE_URL and DATABASE_AUTH_TOKEN empty to use
# local SQLite at CAPI_DB_PATH. For Turso, set the TURSO_* pair below instead.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
CAPI_DB_PATH=data/capi.sqlite

# Optional Turso connection (both values are required together).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
