# Server
CAPI_ADDR=:3210
CAPI_PUBLIC_BASE_URL=http://127.0.0.1:3210
CAPI_TRUSTED_ORIGINS=http://127.0.0.1:3210,http://localhost:3210

# Persistence
CAPI_DATA_DIR=data
CAPI_DB_PATH=data/capi.sqlite
CAPI_FILES_DIR=data/files
CAPI_BACKUP_RETENTION=14

# Optional first admin account: register with this email to receive admin role.
CAPI_ADMIN_EMAIL=

# Optional JEV policy endpoint. When set, CAPI calls <url>/v1/evaluate before relaying.
CAPI_JEV_URL=

# Optional built-in redaction before upstream relay.
CAPI_REDACT=false

# Operations
CAPI_ALERT_WEBHOOK_URL=
CAPI_RELAY_TIMEOUT_MS=120000
CAPI_LOG_LEVEL=info
