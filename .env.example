# Local development defaults to SQLite at CAPI_DB_PATH.
CAPI_DB_PATH=data/capi.sqlite

# Comma-separated additional browser origins allowed for cookie-authenticated
# requests when a reverse proxy reports a different public host.
CAPI_TRUSTED_ORIGINS=https://capi.run,https://www.capi.run

# Set both Turso values for deployment or remote development. Do not set the
# generic DATABASE_* variables and TURSO_* variables to different databases.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional generic libSQL override; leave empty when using the Turso variables.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Legacy SMTP bootstrap values. Configure ongoing email settings in the admin console.
# Use an SMTP authorization code, not your QQ password.
QQ_SMTP_USER=
QQ_SMTP_PASSWORD=

# Optional webhook receiving JSON alerts when readiness checks fail.
CAPI_ALERT_WEBHOOK_URL=

# Local SQLite/file backup settings. Defaults keep backups inside the persisted data directory.
CAPI_BACKUP_DIR=data/backups
CAPI_BACKUP_RETENTION=14
